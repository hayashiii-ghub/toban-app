{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toban",
  "main": "server/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toban-maker-db",
      // ここは書き換えない。pnpm build が scripts/prepare-wrangler-config.mjs で
      // CLOUDFLARE_D1_DATABASE_ID に置き換えた wrangler.deploy.jsonc を作り、それでビルドする。
      "database_id": "__CLOUDFLARE_D1_DATABASE_ID__",
      "preview_database_id": "__CLOUDFLARE_D1_PREVIEW_DATABASE_ID__",
      "migrations_dir": "server/db/migrations",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
